{
  "name": "ventas-pos",
  "version": "1.0.0",
  "description": "Sistema POS Desktop para Ventas-App",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build:preload && concurrently \"npm run dev:react\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:react": "vite",
    "build": "npm run build:main && npm run build:renderer && electron-builder",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc electron/preload.ts --outDir dist --target ES2020 --module CommonJS --esModuleInterop --skipLibCheck --types node",
    "build:renderer": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "pos",
    "electron",
    "ventas"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/minimatch": "^6.0.0",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.3",
    "vite": "^7.3.1",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@supabase/supabase-js": "^2.91.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.10"
  },
  "build": {
    "appId": "com.ventasapp.pos",
    "productName": "Ventas POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
